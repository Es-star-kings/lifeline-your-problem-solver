# LIFELINE provider configuration
#
# Point this at a server-side proxy that speaks the OpenAI chat-completions
# shape and forwards to Gemma with your real API key. The browser never sees
# the key — only this endpoint URL.
# Leave blank to run entirely on the offline intelligence provider.
VITE_GEMMA_ENDPOINT=

# Optional. Defaults to gemma-3-4b-it.
VITE_GEMMA_MODEL=